pipeline{
    agent any
    tools {
        jdk 'jdk-21'
        maven 'maven-3'
    }
    stages {
      stage('Checkout Code') {
        steps {
       // Pulls the latest code from your GitHub repository
       checkout scm
       }
      }
      stage('Build and Test') {
          steps {
             dir('eureka-server'){
               bat 'mvn clean package'
             }
          }
      }
    stage('Archive Artifact') {
        steps {
            archiveArtifacts artifacts: 'eureka-server/target/*.jar', fingerprint: true
        }
    }

    }
}