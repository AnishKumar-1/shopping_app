pipeline {
 agent any
 tools {
    jdk 'jdk-21'
    maven 'maven-3'
}
stages {
 stage('checkout scm') {
    steps {
    // Pulls the latest code from your GitHub repository
      checkout scm
}
stage('Build and Test') {
    steps {
        dir("product-service")  {
        steps {
            bat 'mvn clean package -Dspring.profiles.active=test'
}
}
}
}
stage('Archive Artifact') {
    steps {
    archiveArtifacts artifacts: 'product-service/target/*.jar', fingerprint: true
}
}
}
}