pipeline {
    agent any
    tools {
        jdk 'jdk-21'
        maven 'maven-3'
    }
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        stage('Build and Test') {
            steps {
                // Fixed: Added comma between credentialsId and variable
                withCredentials([string(credentialsId: 'jwt-secret', variable: 'SECRET_KEY')]) {
                    dir('authentication-service') {
                        bat 'mvn clean package -Dspring.profiles.active=test -Djwt.secret.key=%SECRET_KEY%'
                    }
                }
            }
        }
        stage('Archive Artifact') {
            steps {
                archiveArtifacts artifacts: 'authentication-service/target/*.jar', fingerprint: true
            }
        }
    }
}